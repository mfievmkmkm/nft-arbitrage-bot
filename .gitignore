# ============================================================================
# NFT Gift Bot - Git Ignore Rules
# ============================================================================
# Prevents sensitive data, credentials, and generated files from being
# committed to version control.
#
# IMPORTANT: Before first commit, verify that config.py and *.db files
# are NOT tracked with: git status
#
# Repository: https://github.com/Elchin-bit/nft-arbitrage-bot
# ============================================================================


# ============================================================================
# 🔐 SECRETS & CREDENTIALS (NEVER COMMIT!)
# ============================================================================
# Configuration files with API keys and tokens
config.py
secrets.py
credentials.json

# Environment variables
*.env
.env
.env.local
.env.production
.env.*.local

# Authentication tokens
auth_token.txt
*.token
*.key
*.pem


# ============================================================================
# 💾 DATABASE FILES
# ============================================================================
# SQLite databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
nft_gifts.db
nft_bot.db

# Database backups
*.db.backup
*.sqlite.backup
backups/*.db
data/*.db


# ============================================================================
# 📝 LOGS & MONITORING
# ============================================================================
# Log files
*.log
*.log.*
nft_bot.log
error.log
debug.log

# Log directories
logs/
log/
*.logs/

# Rotating logs
*.log.[0-9]*


# ============================================================================
# 🐍 PYTHON
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt


